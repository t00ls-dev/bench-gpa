# Database (MariaDB)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="bench_gpa"
DB_USER="bench_gpa"
DB_PASS="<password>"

# JWT
# Session duration (inactivity / ceiling / "stay signed in") is no longer
# configurable via env, see src/lib/auth-config.ts.
JWT_SECRET="<base64_64_chars>"

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY="<secret_key>"
TURNSTILE_BYPASS="false"
VITE_TURNSTILE_SITE_KEY="<site_key>"
VITE_TURNSTILE_BYPASS="false"

# Sentry (error tracking)
# Same DSN twice: SENTRY_DSN is read by the server (Node/Bun), VITE_SENTRY_DSN
# is the only way Vite embeds the value into the browser bundle. Without
# either, the SDK stays disabled (enabled: false) and sends nothing, so it's
# safe to leave both blank in dev.
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# Tests
TEST_ADMIN_USERNAME="test"
TEST_ADMIN_PASSWORD="<test_admin_password>"
TEST_APP_URL="http://localhost:3000"
