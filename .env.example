# Banco de Dados (MariaDB)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="bench_gpa"
DB_USER="bench_gpa"
DB_PASS="<senha>"

# JWT
# A duração da sessão (inatividade / teto / "manter conectado") não é mais
# configurável por env — ver src/lib/auth-config.ts.
JWT_SECRET="<base64_64_chars>"

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY="<secret_key>"
TURNSTILE_BYPASS="false"
VITE_TURNSTILE_SITE_KEY="<site_key>"
VITE_TURNSTILE_BYPASS="false"

# Sentry (rastreamento de erro)
# Mesmo DSN duas vezes: SENTRY_DSN é lido pelo servidor (Node/Bun), a
# VITE_SENTRY_DSN é a única forma do Vite embutir o valor no bundle do
# navegador. Sem nenhuma das duas, o SDK fica desabilitado (enabled: false)
# e não manda nada, então é seguro deixar em branco em dev.
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# Testes
TEST_ADMIN_USERNAME="test"
TEST_ADMIN_PASSWORD="<senha_admin_teste>"
TEST_APP_URL="http://localhost:3000"
