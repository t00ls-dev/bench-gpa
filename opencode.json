{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "description": "Build, compilation, and deployment tasks"
    },
    "plan": {
      "model": "opencode/nemotron-3-ultra-free",
      "mode": "primary",
      "description": "Planning, analysis, and architectural decisions"
    },
    "explore": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "mode": "subagent",
      "description": "Code exploration, search, and discovery"
    }
  }
}
