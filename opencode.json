{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "description": "Build, compilation, and deployment tasks",
      "color": "success"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "description": "Planning, analysis, and architectural decisions",
      "color": "primary"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "description": "Code exploration, search, and discovery",
      "color": "info"
    }
  }
}
